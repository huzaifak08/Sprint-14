rules_version = '2';

// Cloud Storage rules for Digital Munshi.
// Deploy: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Profile pictures: users/{uid}/...
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && (request.resource == null || isImageUnder5MB());
    }

    // Business logos: businesses/{bid}/logo.jpg
    // The app uploads the logo before the business doc reaches Firestore,
    // so a not-yet-existing business (random UUID id) is allowed too.
    match /businesses/{bid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.resource == null || isImageUnder5MB())
        && (
          !firestore.exists(/databases/(default)/documents/businesses/$(bid))
          || firestore.get(/databases/(default)/documents/businesses/$(bid)).data.ownerId == request.auth.uid
        );
    }

    // Everything else is denied by default.
  }
}
